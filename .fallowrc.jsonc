{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "minimumVersion": "3.24.0",
  // These files are loaded by their tools rather than through import edges.
  "entry": [
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "apps/web/src/start.ts",
    "scripts/**/*.ts",
    "apps/web/src/**/*.stories.tsx",
  ],
  "ignorePatterns": [
    "apps/alerts/**",
    "apps/chat/**",
    "apps/donations/**",
    "apps/video/**",
    "apps/web/.ladle/**",
  ],
  "ignoreFindings": ["apps/web/src/components/ui/**"],
  // These tools are invoked from justfile recipes or loaded as tooling by config files.
  "ignoreDependencies": [
    "@dotenvx/dotenvx",
    "@tanstack/intent",
    "@ladle/react",
    "concurrently",
    "dbmate",
    "oxlint",
    "oxlint-tsgolint",
  ],
  "rules": {
    "boundary-violation": "off",
    "policy-violation": "off",
  },
}

{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "apps/web/assets/logo.png",
  "scripts": [
    {
      "name": "Initialize worktree",
      "command": "just t3-worktree-init \"$T3CODE_PROJECT_ROOT\"",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Prepare PR",
      "command": "git fetch origin && git rebase origin/main && just check && git push --force-with-lease",
      "icon": "configure"
    }
  ]
}
